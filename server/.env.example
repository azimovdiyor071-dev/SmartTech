# ── SmartTech CRM backend configuration ──────────────────────────
# Copy this file to ".env" and fill in the values you need.

# PostgreSQL connection string.
# • Leave it UNSET (or delete the line) to use the zero-config file store.
# • Set it to switch to real PostgreSQL — the app auto-creates the tables
#   and seeds data on first run.
#
# Free cloud Postgres in ~2 minutes:
#   1. Go to https://neon.tech and sign up (free).
#   2. Create a project → copy the connection string it shows.
#   3. Paste it below (it looks like the example) and restart the server.
#
# DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Secret used to sign JWT login tokens. Change this for any real deployment.
JWT_SECRET=smarttech-crm-dev-secret-change-me

# Port the API listens on (default 4000).
# PORT=4000
